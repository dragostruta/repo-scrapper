# ---------------------------------------------------------------------------
# Copy to .env and fill in ANTHROPIC_API_KEY. Everything else has a working
# default. Nothing in this file is ever committed with a real value.
# ---------------------------------------------------------------------------

# --- The one variable you must set -----------------------------------------
# Get a key at https://console.anthropic.com/. Leave empty and use
# LLM_PROVIDER=ollama if you would rather run fully local.
ANTHROPIC_API_KEY=

# --- LLM -------------------------------------------------------------------
# anthropic | ollama
LLM_PROVIDER=anthropic
# Any current Anthropic model id. Haiku is the cheap default; swap to a Sonnet
# model if you want better synthesis on large contexts.
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=1024

# Only used when LLM_PROVIDER=ollama.
# - Ollama running natively on your machine (brew install ollama): keep this
#   as http://localhost:11434 for `npm run dev`, or http://host.docker.internal:11434
#   if the API itself runs inside `docker compose up`.
# - Ollama running as the optional `ollama` compose service instead
#   (`docker compose --profile local-llm up`): use http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Embeddings (local, no credentials needed) -----------------------------
# Runs in-process via transformers.js on CPU. First start downloads ~130MB.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16
# Relative path for `npm run dev` (resolves under apps/api/, already
# gitignored). docker-compose.yml overrides this to /data/models - a named
# volume that only exists inside the container - so you never need to set
# an absolute path here yourself.
MODEL_CACHE_DIR=./.cache/models

# --- Database --------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=codedocs
# Host-side URL (pnpm dev). Docker Compose overrides host to "db".
DATABASE_URL=postgresql://app:app@localhost:5432/codedocs?schema=public

# --- Retrieval / cost ------------------------------------------------------
RETRIEVAL_TOP_K=8
CONTEXT_TOKEN_BUDGET=4000
# Cheap lexical boost for identifier-heavy questions (0 disables it).
KEYWORD_BOOST=0.15

# --- Ingest guardrails -----------------------------------------------------
# Same story as MODEL_CACHE_DIR above: relative for local dev, overridden to
# /data/repos by docker-compose.yml for the containerized run.
WORKSPACE_DIR=./.cache/repos
MAX_REPO_SIZE_MB=200
MAX_FILES=5000
MAX_FILE_SIZE_KB=512
CLONE_TIMEOUT_MS=120000
ALLOWED_REPO_HOSTS=github.com

# --- Runtime ---------------------------------------------------------------
API_PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# --- Web -------------------------------------------------------------------
# Browser-visible API origin.
NEXT_PUBLIC_API_URL=http://localhost:3001
